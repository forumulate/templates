      "headerLinks": [
        {
          "href": "/f/your-org/your-forum/about",
          "label": "Get Started"
        },
        {
          "href": "/f/your-org/your-forum/categories",
          "label": "Forum Categories",
          "children": [
            {
              "href": "/f/your-org/your-forum/c/news-and-updates",
              "label": "News and Updates"
            },
            {
              "href": "/f/your-org/your-forum/c/ask-the-community",
              "label": "Ask the Community"
            },
            {
              "href": "/f/your-org/your-forum/c/showcase-your-work",
              "label": "Showcase Your Work"
            },
            {
              "href": "/f/your-org/your-forum/c/suggest-a-feature",
              "label": "Suggest a Feature"
            },
            {
              "href": "/f/your-org/your-forum/c/report-a-problem",
              "label": "Report a Problem"
            },
            {
              "href": "/f/your-org/your-forum/c/chat-and-connect",
              "label": "Chat and Connect"
            }
          ]
        },
        {
          "href": "/f/your-org/your-forum/c/news-and-updates",
          "label": "Product Updates"
        },
        {
          "href": "/f/your-org/your-forum/about",
          "label": "Help Center"
        }
      ],
      "signInStyle": {
        "icon": "user",
        "look": "outline",
        "label": "Login",
        "order": "after-ctas",
        "phone": "bar"
      },
      "themeToggle": {
        "show": false,
        "position": "footer"
      }
    },
    "layout": {
      "frame": "wide",
      "widths": {
        "max": "1150px",
        "list": "1150px",
        "text": "740px",
        "board": "1150px"
      },
      "indexHeader": "hide"
    },
    "palette": {
      "ink": "#1e1e1e",
      "line": "#e6e6e6",
      "muted": "#8a8a8a",
      "heading": "#000000",
      "success": "#14ae5c",
      "surface": "#ffffff",
      "background": "#ffffff",
      "header_primary": "#000000",
      "header_background": "#ffffff"
    },
    "components": {
      "input": {
        "border": "#ffffff",
        "radius": 8,
        "background": "#ffffff"
      },
      "button": {
        "radius": 6,
        "weight": "medium"
      }
    },
    "typography": {
      "levels": {
        "topicTitle": {
          "size": {
            "lg": 20,
            "sm": 20
          }
        }
      }
    },
    "accentColor": "#14ae5c",
    "colorScheme": "light",
    "primaryColor": "#000000",
    "customFontUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap",
    "customFontFamily": "Inter"
