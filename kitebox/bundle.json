{
  "format": "forumulate.theme-bundle",
  "formatVersion": 1,
  "meta": {
    "name": "Kitebox Forum",
    "slug": "template-kitebox",
    "description": "A bright hero with illustrated shapes and a search box, an icon grid of categories and featured topics.",
    "author": {
      "name": "Forumulate",
      "url": "https://forumulate.com"
    },
    "version": "1.0.0",
    "license": "MIT",
    "tags": [
      "light",
      "forum",
      "community",
      "colourful",
      "template"
    ],
    "spaceTypes": [
      "FORUM"
    ]
  },
  "requiredOrigins": {
    "fonts": [
      "https://fonts.googleapis.com",
      "https://fonts.gstatic.com"
    ]
  },
  "theme": {
    "forum": {
      "list": {
        "pin": "word",
        "tags": "text",
        "paging": "more",
        "avatars": "op",
        "density": "comfortable",
        "excerpt": "all",
        "avatarSize": 32,
        "thumbnails": "none",
        "titleLines": {
          "lg": 2,
          "md": 2,
          "sm": 3
        },
        "statusGlyph": "check",
        "excerptLines": 2
      },
      "look": "cards",
      "post": {
        "date": "relative",
        "menu": [
          "like",
          "reply"
        ],
        "name": "name",
        "style": "card",
        "avatar": {
          "size": 40,
          "shape": "circle",
          "position": "inline",
          "positionSm": "inline"
        },
        "header": "stacked",
        "opChip": true,
        "actions": {
          "align": "start",
          "style": "text"
        },
        "bodySize": 14,
        "reactions": "like",
        "gapMarkers": false,
        "menuHidden": [
          "quote",
          "link",
          "bookmark",
          "flag"
        ],
        "quoteStyle": "card",
        "bodySurface": "#f5f5f5",
        "staffAccent": "none",
        "headingScale": "body",
        "reactionsRow": "inline",
        "newMemberChip": false,
        "bodySurfaceDark": "#2c2c2c"
      },
      "dates": {
        "style": "relative"
      },
      "front": {
        "filters": {
          "items": [
            "latest",
            "solved",
            "unanswered"
          ],
          "links": [],
          "style": "underline",
          "newTopic": false
        }
      },
      "topic": {
        "map": {
          "show": "never"
        },
        "rail": [
          "related",
          "solved"
        ],
        "share": {
          "mode": "none"
        },
        "header": {
          "meta": [
            "replies",
            "views"
          ],
          "tags": "none",
          "category": "none",
          "kindChip": false,
          "solvedPill": {
            "style": "solid",
            "placement": "before-title"
          },
          "statusGlyph": "pill"
        },
        "measure": 740,
        "composer": {
          "signedOut": "none"
        },
        "replyBar": {
          "placement": [
            "after-op",
            "after-answer",
            "end"
          ],
          "signedOut": "bar"
        },
        "timeline": {
          "phone": "none",
          "placement": "none"
        },
        "replySort": "oldest",
        "breadcrumb": "trail",
        "answerStyle": "filled",
        "sortControl": true,
        "titlePlacement": "in-first-post-after-author",
        "answerPlacement": "excerpt"
      },
      "profile": {
        "rail": [
          "solved",
          "tags"
        ]
      },
      "sidebar": {
        "enabled": false
      },
      "tagStyle": "outline",
      "categories": {
        "icons": true
      },
      "categoryPage": {
        "list": "frontPage",
        "rail": [
          "solved",
          "tags"
        ],
        "stats": true,
        "title": "{category}",
        "banner": {
          "style": "color",
          "width": "full",
          "search": true,
          "searchWidth": 400
        },
        "subscribe": true,
        "breadcrumb": "above-banner",
        "subcategories": "none",
        "subscribeStyle": "button"
      },
      "categoriesPage": {
        "beside": "none",
        "fields": [
          "description",
          "counts",
          "logo"
        ],
        "layout": "grid",
        "columns": 3
      }
    },
    "chrome": {
      "ctas": [
        {
          "ink": "#ffffff",
          "href": "/f/your-org/your-forum#new-topic",
          "icon": "plus",
          "label": "Create topic",
          "style": "solid",
          "height": 40,
          "fontSize": 14,
          "background": "#000000"
        }
      ],
      "align": "left",
      "header": {
        "border": "none",
        "navGap": 24,
        "navSize": 14,
        "navWeight": 500,
        "linksAlign": "start",
        "logoHeight": 40,
        "controlsAlign": "end"
      },
      "height": "tall",
      "search": "icon",
      "navMenu": {
        "radius": 8,
        "shadow": "md",
        "trigger": "hover"
      },
      "ctaStyle": "solid",
      "showSignIn": true,
      "footerLinks": [
        {
          "href": "/f/your-org/your-forum/about",
          "label": "Terms & Conditions"
        },
        {
          "href": "/f/your-org/your-forum/about",
