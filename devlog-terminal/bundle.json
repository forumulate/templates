{
  "format": "forumulate.theme-bundle",
  "formatVersion": 1,
  "meta": {
    "name": "Devlog Terminal",
    "slug": "template-devlog-terminal",
    "description": "A dark API changelog: ruled rows, type chips before each title, mono versions, Breaking badges and a \"Latest\" chip on the newest stable release.",
    "author": {
      "name": "Forumulate",
      "url": "https://forumulate.com"
    },
    "version": "1.0.0",
    "license": "MIT",
    "tags": [
      "dark",
      "changelog",
      "api",
      "developer",
      "template"
    ],
    "spaceTypes": [
      "CHANGELOG"
    ]
  },
  "requiredOrigins": {},
  "theme": {
    "colorScheme": "dark",
    "colorSchemeStrict": false,
    "primaryColor": "#e5e7eb",
    "accentColor": "#22d3ee",
    "customFontFamily": "Inter",
    "monoFontFamily": "Source Code Pro",
    "palette": {
      "ink": "#cbd5e1",
      "line": "#1e293b",
      "muted": "#94a3b8",
      "heading": "#e5e7eb",
      "surface": "#111827",
      "background": "#0b1120",
      "footer_primary": "#94a3b8",
      "header_primary": "#e5e7eb",
      "footer_background": "#0b1120",
      "header_background": "#0b1120",
      "success": "#1f8a4c",
      "warning": "#b3600b",
      "danger": "#df1b41",
      "info": "#22d3ee"
    },
    "paletteDark": {
      "ink": "#c9d1e0",
      "line": "#2a3247",
      "muted": "#8d96aa",
      "heading": "#f5f7fb",
      "surface": "#151b2b",
      "background": "#0b1020",
      "footer_primary": "#8d96aa",
      "header_primary": "#f5f7fb",
      "footer_background": "#080c18",
      "header_background": "#0b1020",
      "success": "#3ecf8e",
      "warning": "#f5a623",
      "danger": "#ff5c7a",
      "info": "#9b96ff"
    },
    "onThisPage": "always",
    "typography": {
      "baseSize": 16,
      "levels": {
        "h1": {
          "size": {
            "lg": 40,
            "sm": 30
          },
          "weight": 600,
          "tracking": -0.02,
          "lineHeight": 1.15
        },
        "h2": {
          "size": 20,
          "weight": 600,
          "lineHeight": 1.3,
          "spaceBefore": "40px"
        },
        "body": {
          "lineHeight": 1.6
        },
        "indexTitle": {
          "size": {
            "lg": 40,
            "sm": 30
          },
          "weight": 600,
          "tracking": -0.03,
          "lineHeight": 1
        },
        "entryTitle": {
          "size": 16,
          "weight": 600,
          "lineHeight": 1.4
        },
        "eyebrow": {
          "font": "mono",
          "case": "upper",
          "size": 12,
          "tracking": 0.04,
          "color": "#687385"
        }
      }
    },
    "layout": {
      "widths": {
        "max": "1200px",
        "list": "960px",
        "text": "760px"
      },
      "heroDecor": {
        "style": "grid",
        "color": "#e3e8ee",
        "colorDark": "#1c2335",
        "height": 260,
        "intensity": 50
      }
    },
    "components": {
      "radius": 6,
      "code": {
        "background": "#f6f8fa",
        "border": "#e3e8ee",
        "ink": "#1a1f36",
        "radius": 6
      },
      "button": {
        "background": "#635bff",
        "ink": "#ffffff",
        "radius": 6,
        "weight": "medium"
      },
      "input": {
        "background": "#ffffff",
        "border": "#e3e8ee",
        "ink": "#1a1f36",
        "radius": 6
      },
      "link": {
        "color": "#635bff",
        "colorDark": "#9b96ff",
        "underline": "hover"
      },
      "image": {
        "backdrop": {
          "style": "gradient",
          "color": "#f6f8fa",
          "to": "#eceefd",
          "colorDark": "#151b2b",
          "toDark": "#1d1f45",
          "angle": 135,
          "padding": 24
        }
      }
    },
    "chrome": {
      "align": "split",
      "sticky": true,
      "header": {
        "height": {
          "lg": 64,
          "sm": 56
        },
        "border": "line",
        "borderColor": "#e3e8ee",
        "navSize": 14,
        "navInk": "#3c4257",
        "navInkDark": "#c9d1e0",
        "logoHeight": 28
      },
      "headerLinks": [
        {
          "href": "/c/your-org/your-changelog",
          "label": "API reference"
        },
        {
          "href": "/c/your-org/your-changelog",
          "label": "Guides"
        },
        {
          "href": "/c/your-org/your-changelog",
          "label": "Changelog"
        },
        {
          "href": "/c/your-org/your-changelog",
          "label": "Upgrades"
        }
      ],
      "cta": {
        "href": "/c/your-org/your-changelog",
        "label": "Dashboard",
        "showOnPhone": false
      },
      "ctaStyle": "solid",
      "showSignIn": false,
      "socialLinks": [
        {
          "platform": "github",
          "href": "https://example.com/github"
        }
      ],
      "footerColumns": [
        {
          "heading": "Developers",
          "links": [
            {
              "href": "/c/your-org/your-changelog",
              "label": "API reference"
            },
            {
              "href": "/c/your-org/your-changelog",
              "label": "SDKs"
            },
            {
              "href": "/c/your-org/your-changelog",
              "label": "Webhooks"
            },
            {
              "href": "/c/your-org/your-changelog",
              "label": "Versioning"
            }
          ]
        },
        {
          "heading": "Resources",
          "links": [
            {
              "href": "/c/your-org/your-changelog",
              "label": "Changelog"
            },
            {
              "href": "/c/your-org/your-changelog",
              "label": "Status"
            },
            {
              "href": "/c/your-org/your-changelog",
              "label": "Support"
            }
          ]
        }
      ],
      "footerLinks": [
        {
          "href": "/c/your-org/your-changelog",
          "label": "Privacy"
        },
        {
          "href": "/c/your-org/your-changelog",
          "label": "Terms"
        }
      ],
      "copyright": "© 2026 Your Brand.",
      "themeToggle": {
        "show": true
      }
    },
    "changelog": {
      "dateFormat": "day-month-short",
      "versionBadge": {
        "mono": true,
        "fill": "#f6f8fa",
        "ink": "#1a1f36",
        "fillDark": "#151b2b",
        "inkDark": "#f5f7fb"
      },
      "facts": {
        "look": "chips",
        "cta": "button"
      },
      "look": "devlog",
      "latestLabel": true,
      "helpful": {
        "show": true
      },
      "autolink": {
        "repoUrl": "https://github.com/your-org/your-repo"
      }
    }
  },
  "components": [],
  "frontPages": [
    {
      "target": "CHANGELOG",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "section",
            "attrs": {
              "key": "hero",
              "role": "layout",
              "fullBleed": true,
              "padding": {
                "top": 72,
                "bottom": 40
              },
              "border": {
                "width": 1,
                "color": "#e3e8ee",
                "sides": "bottom"
              }
            },
            "content": [
              {
                "type": "spaceBand",
                "attrs": {
                  "band": "title"
                }
              }
            ]
          },
          {
            "type": "spaceBand",
            "attrs": {
              "band": "filters",
              "style": "checklist"
            }
          },
          {
            "type": "spaceFeed",
            "attrs": {
              "space": "self",
              "controls": true,
              "limit": 30,
              "layout": "compact"
            }
          },
          {
            "type": "spaceBand",
            "attrs": {
              "band": "archive"
            }
          }
        ]
      },
      "paddingTop": {
        "lg": "0px",
        "sm": "0px"
      }
    }
  ]
}
