{
  "format": "forumulate.space-template",
  "formatVersion": 1,
  "id": "heapfield",
  "type": "FORUM",
  "name": "Heapfield",
  "description": "A Q&A forum: vote and answer counts beside each question, tag chips, a left nav and a sidebar of featured posts.",
  "modelledOn": "A programming Q&A site",
  "features": [
    "Zero custom CSS — every detail is a theme setting"
  ],
  "tags": [
    "light",
    "forum",
    "q-and-a",
    "developer"
  ],
  "thumbnail": "/templates/heapfield.jpg",
  "assets": {
    "/api/assets/00000000-0000-4000-8000-000000000001": "assets/hf-wordmark.svg",
    "/api/assets/00000000-0000-4000-8000-000000000002": "assets/hf-wordmark-dark.svg",
    "/api/assets/00000000-0000-4000-8000-000000000003": "assets/hf-mark.svg"
  },
  "brand": {
    "logoUrl": "/api/assets/00000000-0000-4000-8000-000000000001",
    "logoUrlDark": "/api/assets/00000000-0000-4000-8000-000000000002",
    "faviconUrl": "/api/assets/00000000-0000-4000-8000-000000000003"
  },
  "layout": {
    "preset": "dense",
    "frontDoor": {
      "showVotes": true,
      "badgeStyle": "pill",
      "showSearch": false,
      "showIdentity": false,
      "showCategoryBadge": false,
      "showCategoryCards": false,
      "showLeaderboardLink": false
    }
  },
  "piecePage": null,
  "tagInfo": [],
  "authors": [],
  "forms": [],
  "posts": [],
  "frontPage": {
    "doc": {
      "type": "doc",
      "content": [
        {
          "type": "columns",
          "attrs": {
            "gap": "md",
            "valign": "center",
            "stackOn": "never"
          },
          "content": [
            {
              "type": "column",
              "attrs": {
                "width": 75
              },
              "content": [
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "text": "Newest Questions",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "column",
              "attrs": {
                "fit": "content",
                "align": "end",
                "width": 25
              },
              "content": [
                {
                  "type": "button",
                  "attrs": {
                    "href": "/f/your-org/your-forum#composer",
                    "label": "Ask Question",
                    "style": "primary",
                    "action": "link"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "spaceBand",
          "attrs": {
            "band": "filters"
          }
        },
        {
          "type": "spaceFeed",
          "attrs": {
            "layout": "rows",
            "controls": true,
            "pageSize": 15,
            "paginate": true
          }
        }
      ]
    },
    "hideTitle": true,
    "width": "list"
  }
}
