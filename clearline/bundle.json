{
  "format": "forumulate.theme-bundle",
  "formatVersion": 1,
  "meta": {
    "name": "Clearline",
    "slug": "template-clearline",
    "description": "A corporate compliance refresher: a calm teal landing with a countdown to the enrolment deadline, lessons that open in order, true/false and short-answer checks, a timed assessment drawn from a question bank, and a minimal certificate with an expiry date and a QR code.",
    "author": {
      "name": "Forumulate",
      "url": "https://forumulate.com"
    },
    "version": "1.0.0",
    "license": "MIT",
    "tags": [
      "courses",
      "compliance",
      "corporate",
      "template"
    ],
    "spaceTypes": [
      "COURSES"
    ]
  },
  "requiredOrigins": {},
  "theme": {
    "colorScheme": "light",
    "primaryColor": "#0f3d3e",
    "accentColor": "#2bb38f",
    "customFontUrl": "https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap",
    "customFontFamily": "Inter",
    "headingFontFamily": "Newsreader",
    "bodyFontFamily": "Inter",
    "palette": {
      "background": "#fbfdfc",
      "surface": "#ffffff",
      "ink": "#1d2b2b",
      "heading": "#0f2424",
      "muted": "#5b6e6c",
      "line": "#dbe7e4",
      "header_background": "#ffffff",
      "header_primary": "#0f2424",
      "footer_background": "#0f3d3e",
      "footer_primary": "#d9efe9",
      "success": "#2b8a63",
      "warning": "#b7791f",
      "danger": "#b42318",
      "info": "#2563eb"
    },
    "typography": {
      "baseSize": 17,
      "headingWrap": "balance",
      "levels": {
        "h1": {
          "size": {
            "lg": 56,
            "sm": 38
          },
          "weight": 500,
          "tracking": -0.02,
          "lineHeight": 1.05
        },
        "h2": {
          "size": {
            "lg": 34,
            "sm": 27
          },
          "weight": 500,
          "tracking": -0.01,
          "lineHeight": 1.15
        },
        "h3": {
          "size": 21,
          "weight": 600
        },
        "body": {
          "lineHeight": 1.65
        }
      }
    },
    "components": {
      "radius": 14,
      "button": {
        "background": "#d9572b",
        "ink": "#ffffff",
        "radius": 999,
        "weight": "semibold"
      }
    },
    "chrome": {
      "header": {
        "height": 68,
        "border": "none"
      },
      "showSignIn": true,
      "copyright": "© 2026 Your Brand."
    },
    "courses": {
      "look": "minimal-text",
      "landing": {
        "layout": "hero-split",
        "showStats": true,
        "showInstructors": true,
        "showOutcomes": true,
        "showPrereqs": true,
        "coverAspect": "video",
        "countdown": true,
        "phoneCta": "sticky",
        "width": "default"
      },
      "outline": {
        "style": "checklist",
        "showDurations": true,
        "showKinds": true,
        "showModuleProgress": true,
        "numbering": "1.1",
        "density": "cozy"
      },
      "lesson": {
        "sidebar": "curriculum",
        "progressBar": "sidebar",
        "completion": "complete-and-continue",
        "endCard": "completed-next",
        "showUpdated": true,
        "printButton": true
      },
      "access": {
        "lockStyle": "dim",
        "showDripDates": true
      },
      "quiz": {
        "layout": "one-at-a-time",
        "options": "tiles",
        "result": "breakdown",
        "showProgress": true,
        "showTimer": true
      },
      "module": {
        "layout": "list",
        "showCover": true,
        "showDescription": true,
        "showProgress": true
      },
      "lock": {
        "card": "card",
        "showPreviewCta": true,
        "showOutline": true
      },
      "dashboard": {
        "layout": "list",
        "showPaths": true,
        "showCertificates": true
      },
      "paths": {
        "layout": "steps",
        "showCover": true,
        "showFacts": true
      },
      "catalog": {
        "layout": "list",
        "sort": "title",
        "filters": [
          "topic"
        ]
      },
      "certificate": {
        "layout": "minimal",
        "logo": true,
        "border": "single",
        "font": "sans",
        "qr": true,
        "showScore": true,
        "showHours": true,
        "backgroundUrl": "/api/assets/00000000-0000-4000-8000-000000000006",
        "signature": {
          "name": "Mara Lind",
          "title": "Data protection officer"
        },
        "line": "Annual data-protection refresher"
      }
    }
  },
  "components": []
}