{
  "format": "forumulate.theme-bundle",
  "formatVersion": 1,
  "meta": {
    "name": "Threadwell Meta",
    "slug": "template-threadwell",
    "description": "A classic topic list with excerpts, poster avatars, views and activity, and a categories sidebar.",
    "author": {
      "name": "Forumulate",
      "url": "https://forumulate.com"
    },
    "version": "1.0.0",
    "license": "MIT",
    "tags": [
      "light",
      "forum",
      "community",
      "classic",
      "template"
    ],
    "spaceTypes": [
      "FORUM"
    ]
  },
  "requiredOrigins": {},
  "theme": {
    "forum": {
      "list": {
        "pin": "glyph",
        "heat": {
          "views": [
            500,
            800,
            1200
          ],
          "replies": [
            5,
            7,
            9
          ]
        },
        "tags": "text",
        "phone": {
          "avatarSize": 40
        },
        "header": {
          "case": "title",
          "align": "start"
        },
        "paging": "more",
        "avatars": "posters",
        "columns": [
          "posters",
          "replies",
          "views",
          "activity"
        ],
        "density": "cozy",
        "excerpt": "pinned",
        "metaSize": "13px",
        "titleSize": "17px",
        "avatarSize": 24,
        "titleLines": {
          "lg": 2,
          "md": 2,
          "sm": 3
        },
        "excerptLines": 3,
        "tagsPosition": "inline"
      },
      "look": "board",
      "post": {
        "date": "relative",
        "menu": [
          "like",
          "link",
          "reply"
        ],
        "name": "name",
        "flair": "avatar-overlay",
        "quote": {
          "avatar": true
        },
        "style": "rule",
        "avatar": {
          "size": "md",
          "shape": "circle",
          "position": "gutter",
          "positionSm": "inline"
        },
        "badges": "hover",
        "opChip": false,
        "actions": {
          "align": "end",
          "style": "icons"
        },
        "bodySize": 15,
        "reactions": "like",
        "gapMarkers": 7,
        "menuHidden": [
          "bookmark",
          "quote",
          "flag",
          "edit",
          "history"
        ],
        "quoteStyle": "card",
        "staffAccent": "brand",
        "headingScale": "body",
        "reactionsRow": "inline",
        "acceptedStyle": "gutter-check"
      },
      "dates": {
        "style": "compact"
      },
      "front": {
        "align": "start",
        "filters": {
          "items": [
            "latest",
            "hot",
            "top",
            "categories"
          ],
          "links": [],
          "style": "underline",
          "pickers": [
            "category",
            "tags"
          ],
          "newTopic": true
        }
      },
      "topic": {
        "map": {
          "show": "auto",
          "style": "full",
          "minReplies": 3
        },
        "align": "start",
        "share": {
          "mode": "none"
        },
        "header": {
          "tags": "chips",
          "category": "chip",
          "kindChip": false,
          "statusGlyph": true
        },
        "actions": [],
        "measure": 720,
        "timeline": {
          "phone": "pill",
          "dateStyle": "day-month",
          "placement": "beside-column",
          "minReplies": 3
        },
        "breadcrumb": "none",
        "answerPlacement": "excerpt"
      },
      "chrome": {
        "searchPage": {
          "filters": "top"
        }
      },
      "layout": {
        "topGap": {
          "phone": 12,
          "desktop": 16
        }
      },
      "profile": {
        "summary": {
          "sections": [
            "stats",
            "topReplies",
            "topTopics",
            "topLinks",
            "mostRepliedTo",
            "mostLikedBy",
            "mostLiked",
            "topCategories",
            "topBadges"
          ]
        },
        "avatarSize": 120,
        "statsStyle": "inline"
      },
      "sidebar": {
        "tags": [
          "official",
          "release"
        ],
        "icons": true,
        "phone": "drawer",
        "width": 260,
        "footer": [
          "themeToggle"
        ],
        "enabled": true,
        "headings": [
          "categories",
          "tags"
        ],
        "sections": [
          "community",
          "categories",
          "tags"
        ],
        "categories": [
          "news-events",
          "community-building",
          "general",
          "support",
          "contribute",
          "customization",
          "documentation",
          "marketplace"
        ],
        "fullHeight": true,
        "tagsLayout": "list",
        "collapsible": true
      },
      "tagStyle": "plain",
      "tagsPage": {
        "sort": "count"
      },
      "categories": {
        "icons": true
      },
      "categoryPage": {
        "title": "{category}",
        "banner": "auto",
        "liftDark": true,
        "subcategories": "chips"
      },
      "categoriesPage": {
        "beside": "none",
        "fields": [
          "description",
          "subcategories"
        ],
        "layout": "grid",
        "columns": 4,
        "filters": true,
        "descSize": 15,
        "nameSize": 17
      }
    },
    "chrome": {
      "ctas": [
        {
          "ink": "#ffffff",
          "href": "/f/your-org/your-forum",
          "label": "Sign Up",
          "style": "solid",
          "height": 30,
          "fontSize": 14,
          "background": "#6c4fe0"
        }
      ],
      "align": "split",
      "header": {
        "border": "line",
        "linksAlign": "center",
        "logoHeight": 36,
        "controlsAlign": "end"
      },
      "height": "compact",
      "search": "pill",
      "sticky": true,
      "ctaStyle": "pill",
      "showSignIn": true,
      "searchStyle": {
        "kbd": "slash",
        "open": "modal",
        "size": "md",
        "label": "Search",
        "width": 540
      },
      "signInStyle": {
        "icon": "user",
        "look": "solid",
        "label": "Log In",
        "order": "after-ctas"
      },
      "themeToggle": {
        "show": true,
        "style": "cycle",
        "position": "footer"
      },
      "sidebarToggle": {
        "placement": "start",
        "placementPhone": "start"
      },
      "searchPlacement": "center"
    },
    "layout": {
      "frame": "full",
      "widths": {
        "max": "1440px",
        "list": "1180px",
        "text": "800px"
      },
      "indexHeader": "hide"
    },
    "palette": {
      "ink": "#222222",
      "line": "#e9e9e9",
      "love": "#fa6c8d",
      "muted": "#707070",
      "heading": "#222222",
      "success": "#009900",
      "surface": "#ffffff",
      "highlight": "#ffff4d",
      "background": "#ffffff",
      "header_primary": "#222222",
      "header_background": "#ffffff"
    },
    "typography": {
      "levels": {
        "topicTitle": {
          "size": {
            "lg": 24,
            "sm": 22
          }
        }
      }
    },
    "accentColor": "#1a9a3b",
    "colorScheme": "system",
    "paletteDark": {
      "ink": "#dddddd",
      "line": "#2e2e2e",
      "muted": "#a0a0a0",
      "heading": "#f2f2f2",
      "surface": "#181818",
      "background": "#111111",
      "header_primary": "#eeeeee",
      "header_background": "#111111"
    },
    "contentWidth": "wide",
    "primaryColor": "#6c4fe0",
    "customFontUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap",
    "customFontFamily": "Inter"
  },
  "components": []
}
