{
  "format": "forumulate.space-template",
  "formatVersion": 1,
  "id": "gauge-status",
  "type": "STATUS",
  "name": "Gauge Status",
  "description": "A dense, engineering-first status page: response time under every component's bars, square bars with three-decimal uptime, a big uptime headline, a 99.9% target and compact rows.",
  "modelledOn": "An infrastructure monitoring company’s status page",
  "features": [
    "Response time drawn under every component",
    "A large uptime headline over the first group",
    "A 99.9% uptime target: anything below it reads red",
    "Square bars with three-decimal uptime beside each row",
    "Compact density, made for many components",
    "Zero custom CSS — every detail is a theme setting"
  ],
  "tags": [
    "status",
    "dense",
    "charts",
    "sla"
  ],
  "thumbnail": "/templates/gauge-status.jpg",
  "assets": {
    "/api/assets/00000000-0000-4000-8000-000000000001": "assets/gauge-mark.svg"
  },
  "brand": {
