      "title": "Type after dark",
      "tags": [
        "typography"
      ],
      "daysAgo": 12,
      "markdown": "Letters behave differently on a dark background. Thin strokes glow, tight spacing closes up, and the weight you chose by daylight suddenly feels too heavy.\n\nPlaceholder typography piece.",
