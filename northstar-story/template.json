    "/api/assets/00000000-0000-4000-8000-000000000005": "assets/film-poster.jpg",
    "/api/assets/00000000-0000-4000-8000-000000000006": "assets/break-dusk.svg",
    "/api/assets/00000000-0000-4000-8000-000000000007": "assets/break-night.svg",
    "/api/assets/00000000-0000-4000-8000-000000000008": "assets/chapter-0.svg",
    "/api/assets/00000000-0000-4000-8000-000000000009": "assets/chapter-1.svg",
