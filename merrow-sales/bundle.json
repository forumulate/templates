{
  "format": "forumulate.theme-bundle",
  "formatVersion": 1,
  "meta": {
    "name": "Merrow Sales",
    "slug": "template-merrow-sales",
    "description": "A two-step contact-sales page: work email and topic first, the qualifying questions after Continue, in a raised card on a bright, generous page.",
    "author": {
      "name": "Forumulate",
      "url": "https://forumulate.com"
    },
    "version": "1.0.0",
    "license": "MIT",
    "tags": [
      "light",
      "contact",
      "sales",
      "steps",
      "template"
    ],
    "spaceTypes": [
      "CONTACT"
    ]
  },
  "requiredOrigins": {},
  "theme": {
    "colorScheme": "light",
    "primaryColor": "#5146e5",
    "accentColor": "#5146e5",
    "customFontUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap",
    "customFontFamily": "Inter",
    "palette": {
      "ink": "#3c4257",
      "line": "#e3e8ee",
      "muted": "#475063",
      "heading": "#0d1b2a",
      "surface": "#f6f8fb",
      "background": "#ffffff",
      "header_primary": "#0d1b2a",
      "header_background": "#ffffff",
      "footer_primary": "#6b7385",
      "footer_background": "#f6f8fb"
    },
    "typography": {
      "baseSize": 17,
      "headingWrap": "balance",
      "levels": {
        "h1": {
          "size": {
            "lg": 48,
            "sm": 34
          },
          "weight": 600,
          "tracking": -0.02,
          "lineHeight": 1.12
        },
        "h2": {
          "size": 22,
          "weight": 600,
          "tracking": -0.01,
          "lineHeight": 1.3
        },
        "body": {
          "lineHeight": 1.6
        }
      }
    },
    "components": {
      "radius": 8,
      "input": {
        "border": "#d5dbe4",
        "radius": 6,
        "background": "#ffffff"
      },
      "button": {
        "ink": "#ffffff",
        "radius": 999,
        "weight": "medium",
        "background": "#5146e5"
      }
    },
    "chrome": {
      "header": {
        "border": "none",
        "height": 72
      },
      "showSignIn": false,
      "themeToggle": {
        "show": false
      },
      "copyright": "© 2026 Your Brand, Inc."
    },
    "contact": {
      "form": {
        "card": {
          "surface": "raised",
          "radius": 12,
          "pad": 32,
          "shadow": "md"
        },
        "labelPosition": "above",
        "columns": 2,
        "fullWidthSubmit": true
      },
      "facts": {
        "look": "kicker",
        "placement": "below"
      },
      "topics": {
        "look": "select"
      },
      "backdrop": {
        "layers": [
          {
            "gradient": {
              "type": "linear",
              "angle": 150,
              "stops": [
                {
                  "color": "#a960ee",
                  "at": 0
                },
                {
                  "color": "#ff333d",
                  "at": 35
                },
                {
                  "color": "#90e0ff",
                  "at": 70
                },
                {
                  "color": "#ffcb57",
                  "at": 100
                }
              ]
            }
          },
          {
            "color": "#ffffff",
            "blend": "soft-light"
          }
        ],
        "extent": "top",
        "height": 520
      }
    }
  },
  "components": []
}
