{
  "format": "forumulate.theme-bundle",
  "formatVersion": 1,
  "meta": {
    "name": "Vantage Contact",
    "slug": "template-vantage-contact",
    "description": "A split contact-sales page: the pitch, three proof numbers and a logo wall on the left; a raised form card on the right that stays in view while you read.",
    "author": {
      "name": "Forumulate",
      "url": "https://forumulate.com"
    },
    "version": "1.0.0",
    "license": "MIT",
    "tags": [
      "light",
      "contact",
      "sales",
      "split",
      "template"
    ],
    "spaceTypes": [
      "CONTACT"
    ]
  },
  "requiredOrigins": {},
  "theme": {
    "colorScheme": "light",
    "primaryColor": "#0a0a0a",
    "accentColor": "#0068d6",
    "customFontUrl": "https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono&display=swap",
    "bodyFontFamily": "Geist",
    "headingFontFamily": "Geist",
    "monoFontFamily": "Geist Mono",
    "palette": {
      "ink": "#4d4d4d",
      "line": "#ebebeb",
      "muted": "#666666",
      "heading": "#0a0a0a",
      "surface": "#fafafa",
      "background": "#ffffff",
      "header_primary": "#0a0a0a",
      "header_background": "#ffffff",
      "footer_primary": "#666666",
      "footer_background": "#fafafa"
    },
    "typography": {
      "baseSize": 16,
      "headingWrap": "balance",
      "levels": {
        "h1": {
          "size": {
            "lg": 48,
            "sm": 34
          },
          "weight": 600,
          "tracking": -0.04,
          "lineHeight": 1.1
        },
        "h2": {
          "size": 24,
          "weight": 600,
          "tracking": -0.02,
          "lineHeight": 1.3
        },
        "body": {
          "lineHeight": 1.6
        }
      }
    },
    "components": {
      "radius": 8,
      "input": {
        "border": "#e5e5e5",
        "radius": 6,
        "background": "#ffffff"
      },
      "button": {
        "ink": "#ffffff",
        "radius": 6,
        "weight": "medium",
        "background": "#0a0a0a"
      }
    },
    "chrome": {
      "header": {
        "border": "line",
        "height": 64,
        "borderColor": "#ebebeb"
      },
      "showSignIn": false,
      "themeToggle": {
        "show": false
      },
      "copyright": "© 2026 Your Brand, Inc."
    },
    "contact": {
      "form": {
        "card": {
          "surface": "raised",
          "radius": 12,
          "pad": 28,
          "shadow": "lg"
        },
        "labelPosition": "above",
        "columns": 2,
        "fullWidthSubmit": true
      },
      "facts": {
        "look": "list",
        "placement": "above"
      },
      "topics": {
        "look": "select"
      }
    }
  },
  "components": []
}
