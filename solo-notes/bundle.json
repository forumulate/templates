{
  "format": "forumulate.theme-bundle",
  "formatVersion": 1,
  "meta": {
    "name": "Solo Notes",
    "slug": "template-solo-notes",
    "description": "A narrow, personal page: the story first, the milestones newest first, where the work has been featured and how to reach the writer.",
    "author": {
      "name": "Forumulate",
      "url": "https://forumulate.com"
    },
    "version": "1.0.0",
    "license": "MIT",
    "tags": [
      "light",
      "personal",
      "creator",
      "minimal",
      "about",
      "template"
    ],
    "spaceTypes": [
      "ABOUT"
    ]
  },
  "requiredOrigins": {},
  "theme": {
    "colorScheme": "light",
    "primaryColor": "#7c3aed",
    "accentColor": "#6d28d9",
    "palette": {
      "ink": "#292524",
      "line": "#e7e5e4",
      "muted": "#78716c",
      "heading": "#1c1917",
      "surface": "#ffffff",
      "background": "#fafaf9",
      "header_primary": "#1c1917",
      "header_background": "#fafaf9",
      "footer_primary": "#78716c",
      "footer_background": "#fafaf9"
    },
    "typography": {
      "baseSize": 16,
      "headingWrap": "balance",
      "levels": {
        "h1": {
          "size": {
            "lg": 40,
            "sm": 32
          },
          "weight": 700,
          "tracking": -0.02,
          "lineHeight": 1.1
        },
        "h2": {
          "size": 26,
          "weight": 650,
          "tracking": -0.01,
          "lineHeight": 1.25
        },
        "body": {
          "lineHeight": 1.65
        }
      }
    },
    "components": {
      "radius": 4,
      "card": {
        "background": "#ffffff",
        "iconSize": 20,
        "arrow": "none"
      },
      "button": {
        "radius": 4,
        "weight": "medium"
      }
    },
    "chrome": {
      "header": {
        "border": "line",
        "height": 64
      },
      "showSignIn": false,
      "themeToggle": {
        "show": false
      },
      "copyright": "© 2026 Your Brand."
    },
    "about": {
      "look": "minimal",
      "page": {
        "width": "narrow"
      },
      "hero": {
        "layout": "minimal",
        "align": "start",
        "size": "md"
      },
      "mission": {
        "size": "lg",
        "align": "start",
        "quote": true,
        "style": "bar"
      },
      "values": {
        "layout": "list"
      },
      "timeline": {
        "layout": "vertical",
        "order": "newest",
        "dates": "year",
        "marker": "dot"
      },
      "press": {
        "layout": "list",
        "showQuotes": true
      },
      "logos": {
        "layout": "row",
        "size": "sm"
      },
      "story": {
        "layout": "stacked",
        "measure": "narrow"
      }
    }
  },
  "components": []
}
