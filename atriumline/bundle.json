{
  "format": "forumulate.theme-bundle",
  "formatVersion": 1,
  "meta": {
    "name": "Atriumline Contact",
    "slug": "template-atriumline",
    "description": "A company contact page for a business with offices around the world: topic cards that open the right form, your sales line and hours with an “Open now” line, and a grid of office cards — photo, address, phone, hours and a map link each.",
    "author": {
      "name": "Forumulate",
      "url": "https://forumulate.com"
    },
    "version": "1.0.0",
    "license": "MIT",
    "tags": [
      "light",
      "contact",
      "offices",
      "company",
      "template"
    ],
    "spaceTypes": [
      "CONTACT"
    ]
  },
  "requiredOrigins": {},
  "theme": {
    "colorScheme": "light",
    "primaryColor": "#1f2a44",
    "accentColor": "#1a8f7a",
    "customFontUrl": "https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap",
    "customFontFamily": "Figtree",
    "palette": {
      "ink": "#33475b",
      "line": "#dfe3eb",
      "muted": "#5c6f82",
      "heading": "#1f2a44",
      "surface": "#f5f8fa",
      "background": "#ffffff",
      "header_primary": "#1f2a44",
      "header_background": "#ffffff",
      "footer_primary": "#dfe3eb",
      "footer_background": "#1f2a44"
    },
    "typography": {
      "baseSize": 17,
      "headingWrap": "balance",
      "levels": {
        "h1": {
          "size": {
            "lg": 48,
            "sm": 34
          },
          "weight": 700,
          "tracking": -0.015,
          "lineHeight": 1.12
        },
        "h2": {
          "size": 24,
          "weight": 600,
          "lineHeight": 1.3
        },
        "body": {
          "lineHeight": 1.6
        }
      }
    },
    "components": {
      "radius": 10,
      "card": {
        "background": "#ffffff",
        "iconSize": 22,
        "arrow": "none"
      },
      "input": {
        "border": "#cbd6e2",
        "radius": 6,
        "background": "#ffffff"
      },
      "button": {
        "ink": "#ffffff",
        "radius": 6,
        "weight": "semibold",
        "background": "#1a8f7a"
      }
    },
    "chrome": {
      "header": {
        "border": "line",
        "height": 72,
        "borderColor": "#dfe3eb"
      },
      "showSignIn": false,
      "themeToggle": {
        "show": false
      },
      "copyright": "© 2026 Your Brand, Inc."
    },
    "contact": {
      "form": {
        "card": {
          "surface": "raised",
          "radius": 12,
          "pad": 32,
          "shadow": "sm"
        },
        "labelPosition": "above",
        "columns": 2,
        "submitAlign": "start"
      },
      "facts": {
        "look": "tiles",
        "placement": "above"
      },
      "topics": {
        "look": "cards",
        "columns": 2
      },
      "offices": {
        "look": "cards",
        "columns": 3,
        "map": "link",
        "showImage": true
      },
      "channels": {
        "look": "cards",
        "heading": "More ways to get help"
      }
    }
  },
  "components": []
}
