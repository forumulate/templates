                  "attrs": {
                    "language": "bash"
                  },
                  "content": [
                    {
                      "text": "$ ledgerline products create --name=\"Canvas tote\"\n$ ledgerline prices create --product=prod_Nx… --unit-amount=4800 --currency=usd",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
