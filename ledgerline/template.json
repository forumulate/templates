              "type": "tab",
              "attrs": {
                "title": "Create a customer"
              },
              "content": [
                {
                  "type": "codeBlock",
                  "attrs": {
                    "language": "bash"
                  },
                  "content": [
                    {
                      "text": "$ ledgerline customers create --email=\"jenny.rosen@example.com\" --name=\"Jenny Rosen\"\n{\n  \"id\": \"cus_Qm8xT2vLp0aZ\",\n  \"object\": \"customer\",\n  \"email\": \"jenny.rosen@example.com\",\n  \"name\": \"Jenny Rosen\",\n  \"livemode\": false\n}",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tab",
              "attrs": {
                "title": "Start a checkout session"
              },
              "content": [
                {
                  "type": "codeBlock",
                  "attrs": {
                    "language": "bash"
                  },
                  "content": [
                    {
                      "text": "$ ledgerline checkout sessions create -d \"line_items[0][price]=price_1Qx\" \\\n    -d \"line_items[0][quantity]=1\" --mode payment --success-url \"https://example.com/success\"\n{\n  \"id\": \"cs_test_a1Lm…\",\n  \"object\": \"checkout.session\",\n  \"amount_total\": 4800,\n  \"currency\": \"usd\",\n  \"status\": \"open\"\n}",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
