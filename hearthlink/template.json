{
  "format": "forumulate.space-template",
  "formatVersion": 1,
  "id": "hearthlink",
  "type": "FORUM",
  "name": "Hearthlink Community",
  "description": "Categories with coloured bars beside the latest topics, under a bright blue header.",
  "modelledOn": "A home-automation project’s community forum",
  "features": [
    "Zero custom CSS — every detail is a theme setting"
  ],
  "tags": [
    "light",
    "forum",
    "community",
    "open-source"
  ],
  "thumbnail": "/templates/hearthlink.jpg",
  "assets": {
    "/api/assets/00000000-0000-4000-8000-000000000001": "assets/hl-mark.svg",
    "/api/assets/00000000-0000-4000-8000-000000000002": "assets/hl-mark-blue.svg"
  },
  "brand": {
    "logoMark": "/api/assets/00000000-0000-4000-8000-000000000001",
    "faviconUrl": "/api/assets/00000000-0000-4000-8000-000000000002"
  },
  "layout": {
    "preset": "dense",
    "frontDoor": {
      "showVotes": false,
      "badgeStyle": "square",
      "showSearch": false,
      "showIdentity": false,
      "showCategoryBadge": true,
      "showLeaderboardLink": false
    }
  },
  "piecePage": null,
  "tagInfo": [],
  "authors": [],
  "forms": [],
  "posts": [],
  "frontPage": {
    "doc": {
      "type": "doc",
      "content": [
        {
          "type": "spaceBand",
          "attrs": {
            "band": "filters"
          }
        },
        {
          "type": "columns",
          "attrs": {
            "gap": "lg",
            "stackOn": "md"
          },
          "content": [
            {
              "type": "column",
              "attrs": {
                "width": 50
              },
              "content": [
                {
                  "type": "spaceCategories",
                  "attrs": {
                    "fields": [
                      "color",
                      "description",
                      "perWeek",
                      "children"
                    ],
                    "layout": "rows",
                    "heading": "Category",
                    "moreLink": false,
                    "topTopics": {
                      "lg": 0,
                      "md": 0,
                      "sm": 3
                    },
                    "topTopicsRow": {
                      "ink": "ink",
                      "meta": [
                        "age",
                        "replies"
                      ],
                      "size": 17
                    }
                  }
                }
              ]
            },
            {
              "type": "column",
              "attrs": {
                "width": 50
              },
              "content": [
                {
                  "type": "spaceFeed",
                  "attrs": {
                    "card": {
                      "image": {
                        "size": "45px",
                        "aspect": "1:1",
                        "radius": "999px",
                        "source": "authorAvatar",
                        "position": "start"
                      },
                      "slots": [
                        "cover",
                        "title",
                        "kicker",
                        "tags"
                      ],
                      "stats": {
                        "heat": true,
                        "icons": false,
                        "fields": [
                          "replies",
                          "activity"
                        ],
                        "position": "end"
                      },
                      "kicker": "category",
                      "divider": "below",
                      "slotGap": 4,
                      "metaLine": [
                        "kicker",
                        "tags"
                      ],
                      "tagStyle": "chip",
                      "statIcons": false,
                      "titleSize": 17,
                      "kickerStyle": {
                        "case": "none",
                        "font": "body",
                        "size": 13,
                        "swatch": true,
                        "weight": 400,
                        "tracking": 0
                      },
                      "titleWeight": 400
                    },
                    "sort": "latest",
                    "limit": 20,
                    "fields": [
                      "avatar",
                      "title",
                      "category",
                      "tags",
                      "replies",
                      "activity"
                    ],
                    "layout": "rows",
                    "heading": {
                      "size": 14,
                      "text": "Latest",
                      "color": "muted",
                      "weight": 400
                    },
                    "paginate": "more",
                    "moreButton": {
                      "label": "More",
                      "style": "outline"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "hideTitle": true,
    "width": 1400,
    "gap": "sm",
    "paddingTop": 16
  }
}
