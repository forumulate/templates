      },
      "offices": {
        "card": {
          "surface": "outline",
          "radius": 12
        }
      },
      "channels": {
        "heading": "Find it yourself",
        "links": [
          {
            "label": "Call us",
            "url": "tel:+15555550100",
            "description": "Weekdays, 8–18 local time"
          }
        ]
      },
      "density": "comfortable"
