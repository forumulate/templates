  "requiredOrigins": {},
  "theme": {
    "colorScheme": "system",
    "palette": {
      "ink": "#3c4257",
      "line": "#e3e8ee",
      "muted": "#697386",
      "heading": "#0f1729",
      "surface": "#f6f9fb",
      "background": "#ffffff",
      "header_primary": "#0f1729",
      "header_background": "#ffffff",
      "footer_primary": "#697386",
      "footer_background": "#f6f9fb"
    },
