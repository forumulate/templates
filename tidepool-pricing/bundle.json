    },
    "typography": {
      "baseSize": 16,
      "headingWrap": "balance",
      "levels": {
        "h1": {
          "size": {
            "lg": 56,
            "sm": 36
          },
          "weight": 800,
          "tracking": -0.03,
          "lineHeight": 1.05
        },
        "h2": {
          "size": {
            "lg": 36,
            "sm": 28
          },
          "weight": 700,
          "tracking": -0.02,
          "lineHeight": 1.15
        },
        "h3": {
          "size": 20,
          "weight": 700
        },
        "eyebrow": {
          "size": 13,
          "weight": 700,
          "case": "upper",
          "tracking": 0.08,
          "color": "#0e7c86",
          "colorDark": "#2dd4bf"
        }
      }
    },
    "components": {
      "radius": 14,
      "button": {
        "radius": 10,
        "weight": "semibold"
      },
      "input": {
        "radius": 10
      },
      "expandable": {
        "style": "row",
        "icon": "chevron",
        "iconPosition": "end",
        "pad": 18
      },
      "link": {
        "underline": "hover"
      }
    },
    "motion": {
      "preset": "subtle",
      "reveal": {
        "effect": "fade-up",
        "targets": [
          "cards",
          "headings"
        ],
        "distance": 16,
        "once": true
      },
      "hover": {
        "card": "lift",
        "button": "lift",
        "link": "fade"
      }
    },
    "chrome": {
      "sticky": true,
      "align": "split",
      "showSignIn": false,
