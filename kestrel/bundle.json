                  "sm": "32px"
                },
                "dateFormat": "day-month",
                "dateLocale": "en-GB",
                "excerptSize": "14px",
                "titleWeight": 450,
                "excerptLines": 3,
                "metaSeparator": "",
                "titleTracking": -0.04,
                "titleLineHeight": 1.25
              },
              "hook": "featured",
              "limit": 3,
              "layout": "grid",
              "columns": {
                "lg": 3,
                "md": 2,
                "sm": 1
              },
              "spaceAfter": "48px",
              "spaceBefore": {
                "lg": "30px",
                "sm": "32px"
              }
            }
          },
          {
            "type": "spaceFeed",
            "attrs": {
              "card": {
                "meta": {
                  "size": "14px",
                  "color": "#666666"
                },
                "slots": [
                  "date",
                  "tags",
                  "title",
                  "byline"
                ],
                "byline": {
                  "role": true,
