{
  "format": "forumulate.theme-bundle",
  "formatVersion": 2,
  "meta": {
    "name": "Kestrel",
    "slug": "template-kestrel",
    "description": "A monochrome developer blog: a dense card grid, tag pills, mega-menu header, six-column footer and a closing call to action under every post.",
    "author": {
      "name": "Forumulate",
      "url": "https://forumulate.com"
    },
    "version": "1.0.0",
    "license": "MIT",
    "tags": [
      "light",
      "developer",
      "minimal",
      "grid",
      "template"
    ],
    "spaceTypes": [
      "BLOG"
    ]
  },
  "requiredOrigins": {},
