      "share": {
        "show": false
      },
      "byline": {
        "role": true,
        "size": 14,
        "color": "ink",
        "stack": true,
        "layout": "inline",
        "avatars": true,
        "placement": "inline",
        "separator": "",
        "avatarSize": 16
