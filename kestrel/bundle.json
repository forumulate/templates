        "items": [
          "date",
          "readTime",
          "pageActions"
        ],
        "phone": "after-head",
        "start": "body",
        "width": "205px",
        "anchor": "edge",
        "labels": false,
        "sticky": true,
        "itemGap": "8px",
        "dateFormat": "medium",
        "dateLocale": "en-GB",
        "phoneLayout": "between"
