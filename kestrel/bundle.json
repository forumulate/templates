      "hover": {
        "card": "none",
        "link": "fade"
      },
      "preset": "none",
      "pageTransition": "fade"
    },
    "palette": {
      "surface": "#ffffff",
      "background": "#fafafa",
      "header_primary": "#171717",
      "header_background": "#fafafa"
    },
    "components": {
      "code": {
        "ink": "#171717",
        "border": "#ebebeb",
        "radius": 8,
        "background": "#ffffff"
      },
      "link": {
        "offset": 3,
        "thickness": 1,
        "underline": "always"
      },
      "list": {
        "markerColor": "#8f8f8f"
      },
      "meta": {
        "tracking": 0
      },
      "focus": {
        "color": "#0070f3",
        "width": 2,
        "offset": 2
      },
      "input": {
        "border": "#ebebeb",
        "radius": 999,
        "background": "#ffffff"
      },
      "button": {
        "ink": "#ffffff",
        "border": "#ebebeb",
        "radius": 6,
        "shadow": "none",
        "weight": "medium",
        "background": "#171717"
      },
      "radius": 6,
      "syntax": {
        "tag": "#c41562",
        "attr": "#0068d6",
        "meta": "#8f8f8f",
        "title": "#7d00cc",
        "number": "#0068d6",
        "string": "#107d32",
        "comment": "#8f8f8f",
        "keyword": "#c41562",
        "built_in": "#a35200"
      },
      "spacing": {
        "block": 1.7,
        "section": 2
      },
      "selection": {
        "ink": "#171717",
        "background": "#cce4ff"
      }
    },
    "typography": {
      "levels": {
        "h1": {
          "size": {
            "lg": 48,
            "sm": 40
          },
          "weight": 450,
          "tracking": -0.06,
          "lineHeight": 1.17
