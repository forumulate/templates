  "components": [
    {
      "format": "forumulate.theme-component",
      "formatVersion": 1,
      "meta": {
        "name": "Closing call to action",
        "slug": "kestrel-closing-cta",
        "description": "A full-width call to action after every post.",
        "author": {
          "name": "Forumulate",
          "url": "https://forumulate.com"
        },
        "version": "1.0.0",
        "license": "MIT",
        "tags": [
          "cta"
        ]
      },
      "css": ".kcta{display:flex;align-items:center;justify-content:space-between;gap:24px;margin:96px 0 0;padding:48px 0;border-top:1px solid #ebebeb}.kcta h2{margin:0;font-size:40px;letter-spacing:-0.06em;font-weight:500}.kcta-b{display:flex;gap:8px}.kcta a{font-size:14px;font-weight:500;padding:8px 14px;border-radius:999px;text-decoration:none}.kcta a.p{background:#171717;color:#fff}.kcta a.s{background:#fff;color:#171717;border:1px solid #ebebeb}",
      "outlets": {
        "blog-post-end": {
          "html": "<div class=\"kcta\"><h2>Ready to ship?</h2><div class=\"kcta-b\"><a class=\"p\" href=\"/b/your-org/your-blog\">Start deploying</a><a class=\"s\" href=\"/b/your-org/your-blog\">Talk to an engineer</a></div></div>",
          "position": "after"
        }
      }
    }
  ],
  "frontPages": [
    {
      "target": "BLOG",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "spaceBand",
            "attrs": {
              "band": "title"
            }
          },
          {
            "type": "spaceBand",
