{
  "format": "forumulate.theme-bundle",
  "formatVersion": 1,
  "meta": {
    "name": "Briefing Room",
    "slug": "template-briefing-room",
    "description": "A webinar series: a calm white page with one blue call to action, the hosts, then each episode as a card with a wide cover; past episodes stay listed with their recordings. Each episode page opens on a wide cover with a sticky register card and every time shown in the host’s zone and the reader’s.",
    "author": {
      "name": "Forumulate",
      "url": "https://forumulate.com"
    },
    "version": "1.0.0",
    "license": "MIT",
    "tags": [
      "events",
      "webinar",
      "series",
      "light",
      "template"
    ],
    "spaceTypes": [
      "EVENTS"
    ]
  },
  "requiredOrigins": {},
  "theme": {
    "colorScheme": "light",
    "primaryColor": "#0a66c2",
    "accentColor": "#0a66c2",
    "customFontUrl": "https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap",
    "customFontFamily": "Source Sans 3",
    "palette": {
      "background": "#ffffff",
      "surface": "#ffffff",
      "ink": "#39414b",
      "heading": "#1b1f24",
      "muted": "#6a737d",
      "line": "#e3e8ee",
      "header_background": "#ffffff",
      "header_primary": "#1b1f24",
      "footer_background": "#f6f8fa",
      "footer_primary": "#6a737d",
      "success": "#1f8a5b",
      "warning": "#b4651c",
      "danger": "#c62828",
      "info": "#0a66c2"
    },
    "typography": {
      "baseSize": 16,
      "levels": {
        "h1": {
          "size": {
            "lg": 36,
            "sm": 28
          },
          "weight": 700,
          "tracking": -0.01,
          "lineHeight": 1.2
        },
        "h2": {
          "size": 24,
          "weight": 700,
          "lineHeight": 1.3
        },
        "body": {
          "lineHeight": 1.6
        }
      }
    },
    "components": {
      "radius": 8,
      "button": {
        "background": "#0a66c2",
        "ink": "#ffffff",
        "radius": 6,
        "weight": "semibold"
      }
    },
    "chrome": {
      "header": {
        "height": 64,
        "border": "line"
      },
      "showSignIn": true,
      "themeToggle": {
        "show": false
      },
      "copyright": "© 2026 Your Brand."
    },
    "events": {
      "list": {
        "layout": "cards",
        "columns": 3,
        "cover": "top",
        "coverAspect": "2:1",
        "dateTile": "none",
        "pastMode": "stacked",
        "pastLimit": 6,
        "showHosts": true,
        "showCapacity": false,
        "showLocation": false,
        "timeDisplay": "both",
        "zoneToggle": true
      },
      "page": {
        "layout": "hero-wide",
        "registerCard": "sticky-side",
        "phoneBar": true,
        "cover": {
          "aspect": "2:1",
          "radius": 12,
          "shadow": "sm"
        },
        "facts": {
          "look": "card"
        },
        "showCountdown": true,
        "showRelated": true,
        "relatedCount": 3,
        "timeDisplay": "both",
        "zoneToggle": true,
        "showMap": false
      },
      "chips": {
        "style": "pill"
      },
      "dateTileTone": {
        "color": "#0a66c2"
      }
    }
  },
  "components": []
}
